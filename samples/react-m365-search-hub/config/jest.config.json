{
  "extends": "@microsoft/spfx-web-build-rig/profiles/default/config/jest.config.json",

  // SPFx resolves the localised strings through webpack at build time, which
  // Jest does not run. Point the module at the English file so tests exercise
  // the same strings the web part ships with, rather than a second copy that
  // could drift.
  "moduleNameMapper": {
    "^M365SearchHubWebPartStrings$": "<rootDir>/jest.strings.js"
  }
}
