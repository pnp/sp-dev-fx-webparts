{
  "extends": "@microsoft/spfx-web-build-rig/profiles/default/config/jest.config.json",
  "setupFiles": ["<rootDir>/config/jest.setup.js"],
  "collectCoverageFrom": [
    "lib-commonjs/utilities/**/*.js",
    "lib-commonjs/compat/**/*.js",
    "lib-commonjs/models/MigrationHistory.js",
    "lib-commonjs/models/RunSummary.js",
    "lib-commonjs/services/migration/PageTransformService.js",
    "lib-commonjs/services/migration/PageNormalizationService.js",
    "lib-commonjs/services/migration/PageMigrationOrchestrator.js",
    "lib-commonjs/services/migration/AssetMigrationService.js",
    "lib-commonjs/services/reporting/ReportExportService.js",
    "lib-commonjs/services/reporting/SharePointReportStorageService.js",
    "lib-commonjs/services/sharepoint/pageMapping.js",
    "lib-commonjs/services/sharepoint/checkoutPolicy.js",
    "lib-commonjs/services/logging/Logger.js",
    "!lib-commonjs/**/*.test.js"
  ],
  "coverageThreshold": {
    "global": {
      "statements": 80,
      "branches": 70,
      "functions": 80,
      "lines": 80
    }
  }
}
