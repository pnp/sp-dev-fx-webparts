{
  "name": "react-accessibility-content-auditor",
  "version": "1.0.0",
  "private": true,
  "description": "Read-only heuristic accessibility and content quality auditor for SharePoint.",
  "engines": {
    "node": ">=22.14.0 <23.0.0"
  },
  "scripts": {
    "build": "heft test --clean --production && heft package-solution --production",
