{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Modern SharePoint page (configure tenant URL)",
      "type": "msedge",
      "request": "launch",
      "url": "https://yourtenant.sharepoint.com/sites/dev/SitePages/SmartSupport.aspx",
      "webRoot": "${workspaceRoot}",
      "sourceMaps": true,
      "sourceMapPathOverrides": {
        "webpack:///.././src/*": "${webRoot}/src/*",
        "webpack:///../../../src/*": "${webRoot}/src/*",
        "webpack:///../../../../src/*": "${webRoot}/src/*",
        "webpack:///../../../../../src/*": "${webRoot}/src/*"
      },
      "runtimeArgs": [
        "--remote-debugging-port=9222",
        "-incognito"
      ]
    }
  ]
}