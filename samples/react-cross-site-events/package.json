{
  "name": "react-cross-site-events",
  "version": "1.0.0",
  "private": true,
  "description": "SPFx 1.23.2 React sample that reads Microsoft 365 group calendar views for bounded SharePoint team-site sources.",
  "scripts": {
    "build": "gulp bundle --ship",
    "clean": "gulp clean",
    "test": "jest --runInBand",
    "test:watch": "jest --watch"
  },
  "engines": {
    "node": ">=18.17.1 <23"
  },
  "dependencies": {
    "@fluentui/react-components": "^9.68.0",
    "@js-temporal/polyfill": "^0.4.4",
    "@microsoft/sp-core-library": "1.23.2",
    "@microsoft/sp-http": "1.23.2",
    "@microsoft/sp-property-pane": "1.23.2",
    "@microsoft/sp-webpart-base": "1.23.2",
    "@pnp/graph": "^4.15.0",
    "react": "17.0.2",
    "react-dom": "17.0.2"
  },
  "devDependencies": {
    "@microsoft/sp-build-web": "1.23.2",
    "@microsoft/rush-stack-compiler-4.7": "0.1.1",
    "@types/jest": "^29.5.14",
    "@types/react": "17.0.83",
    "@types/react-dom": "17.0.26",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "~4.7.4"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": ["<rootDir>/src"],
    "moduleFileExtensions": ["ts", "tsx", "js"],
    "testMatch": ["**/*.test.ts"]
  }
}
