    "group": { "default": "Advanced" },
    "title": { "default": "MCP Client" },
    "description": { "default": "Connects to a Model Context Protocol server over Streamable HTTP, lists its tools and shows the full JSON-RPC trace." },
    "officeFabricIconFontName": "PlugConnected",
    "properties": {
      "endpointUrl": "",
      "useMockServer": true,
      "aadResourceUri": ""
    }
  }]
}
